rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Module Utilisateurs : chacun lit et modifie uniquement son propre profil.
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Le rôle choisi à l'inscription ne peut pas être « admin ».
      allow create: if isOwner(userId)
        && request.resource.data.role in ['proprietaire', 'prestataire', 'refuge'];

      // L'utilisateur ne peut modifier ni son rôle ni son e-mail.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;

      allow delete: if false;

      // Notifications dans l'application.
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(userId);

        // N'importe quel utilisateur connecté peut notifier un autre utilisateur
        // (ex. un refuge qui accepte une candidature). La notification arrive non lue.
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['title', 'body', 'category', 'read', 'createdAt'])
          && request.resource.data.title is string
          && request.resource.data.body is string
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time;

        // Le destinataire peut seulement la marquer comme lue.
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }

      // Module Adoption : favoris et « j'aime » des Happy Tails, privés.
      match /adoptionFavorites/{listingId} {
        allow read, write: if isOwner(userId);
      }
      match /likedHappyTails/{tailId} {
        allow read, write: if isOwner(userId);
      }

      // Assistant IA : compteur de messages du jour (+1 à chaque message, 30 maximum).
      match /assistantUsage/{day} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
          && request.resource.data.count == 1
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count <= 30
          && request.resource.data.updatedAt == request.time;
      }

      // Assistant IA : historique privé des conversations.
      match /assistantChats/{chatId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['title', 'petId', 'petName', 'createdAt', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 60;

        match /messages/{messageId} {
          allow read, delete: if isOwner(userId);
          allow create: if isOwner(userId)
            && request.resource.data.keys().hasOnly(['role', 'text', 'listingIds', 'reminders', 'rating', 'createdAt'])
            && request.resource.data.role in ['user', 'model']
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 4000;
          // Seul l'avis 👍 / 👎 d'une réponse peut changer.
          allow update: if isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
            && (request.resource.data.rating == null || request.resource.data.rating in ['up', 'down']);
        }
      }
    }

    // Module Profils des animaux : chaque fiche, ses photos et ses pesées sont privées à son propriétaire.
    match /pets/{petId} {
      // Les écritures en lot (fiche + photos + pesée) sont vérifiées sur l'état après écriture.
      function petOwnerAfter() {
        return signedIn()
          && getAfter(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
      }

      function petOwner() {
        return signedIn()
          && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
      }

      function validPet(d) {
        return d.keys().hasOnly(['ownerId', 'name', 'species', 'sex', 'breed', 'birthDate',
            'birthDateEstimated', 'chipNumber', 'sterilized', 'notes', 'status', 'archivedReason',
            'favorite', 'contacts', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
          && d.species in ['dog', 'cat', 'rabbit', 'rodent', 'bird', 'other']
          && d.sex in ['male', 'female']
          && d.status in ['active', 'archived']
          && (d.breed == null || (d.breed is string && d.breed.size() <= 80))
          && (d.notes == null || (d.notes is string && d.notes.size() <= 500))
          && (d.chipNumber == null || (d.chipNumber is string && d.chipNumber.matches('^[0-9]{15}$')))
          && (d.birthDate == null || d.birthDate <= request.time)
          && d.contacts is list && d.contacts.size() <= 5;
      }

      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && validPet(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && validPet(request.resource.data);
      // Pas de suppression physique depuis l'application : l'animal est archivé (RG-06, RG-07).
      allow delete: if false;

      // Galerie privée : 5 photos maximum (contrôlé par l'application), images compressées.
      match /photos/{photoId} {
        allow read: if petOwner();
        allow delete: if petOwnerAfter();
        allow create, update: if petOwnerAfter()
          && request.resource.data.keys().hasOnly(['data', 'sortOrder', 'createdAt'])
          && request.resource.data.data is bytes
          && request.resource.data.sortOrder is int
          && request.resource.data.sortOrder >= 0 && request.resource.data.sortOrder <= 4;
      }

      // Pesées : une par jour (identifiant AAAA-MM-JJ), poids entre 0 et 500 kg, date non future.
      match /weights/{entryId} {
        allow read: if petOwner();
        allow delete: if petOwnerAfter();
        allow create, update: if petOwnerAfter()
          && request.resource.data.keys().hasOnly(['measuredOn', 'weightKg', 'note', 'createdAt'])
          && request.resource.data.weightKg is number
          && request.resource.data.weightKg > 0 && request.resource.data.weightKg <= 500
          && request.resource.data.measuredOn <= request.time;
      }
    }

    // Module 3 : Rendez-vous et rappels.
    // Un rendez-vous est lisible par son propriétaire (client) et, pour une réservation, par le prestataire.
    function isParticipant(data) {
      return signedIn()
        && (request.auth.uid == data.ownerId || request.auth.uid == data.get('providerId', null));
    }

    match /appointments/{appointmentId} {
      allow read: if isParticipant(resource.data);

      // Le client crée pour lui-même un rendez-vous futur ; un rendez-vous personnel démarre
      // « confirmé », une réservation « en attente » du prestataire (RG-13, RG-16).
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.version == 1
        && request.resource.data.startsAt is timestamp
        && request.resource.data.endsAt is timestamp
        && request.resource.data.startsAt > request.time
        && request.resource.data.endsAt > request.resource.data.startsAt
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.petName is string
        && request.resource.data.petName.size() > 0
        && ((request.resource.data.providerId == null && request.resource.data.status == 'confirmed')
          || (request.resource.data.providerId != null && request.resource.data.status == 'planned'));

      // Seul un rendez-vous actif change ; terminé et annulé sont définitifs (RG-20).
      // Chaque modification augmente la version : une version obsolète est refusée.
      // Le client et le prestataire ne peuvent pas changer à qui appartient le rendez-vous,
      // et seul le prestataire confirme une réservation (RG-17).
      allow update: if isParticipant(resource.data)
        && resource.data.status in ['planned', 'confirmed']
        && request.resource.data.status in ['planned', 'confirmed', 'completed', 'cancelled']
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('providerId', null) == resource.data.get('providerId', null)
        && !(resource.data.get('providerId', null) != null
          && resource.data.status == 'planned'
          && request.resource.data.status == 'confirmed'
          && request.auth.uid != resource.data.providerId);

      // L'historique est conservé : pas de suppression.
      allow delete: if false;
    }

    // Rappels de soins personnels : visibles et modifiables uniquement par leur propriétaire.
    match /reminders/{reminderId} {
      allow read, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.dueAt is timestamp;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    // ------------------------------------------------------------ Module Adoption

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function listingDoc(listingId) {
      return get(/databases/$(database)/documents/adoptions/$(listingId));
    }

    // Annonces : visibles par tous une fois publiées ; le brouillon et l'archive restent privés.
    match /adoptions/{listingId} {
      allow read: if resource.data.status in ['disponible', 'reservee', 'adoptee']
        || (signedIn() && resource.data.publisherId == request.auth.uid);

      allow create: if signedIn()
        && userRole() in ['proprietaire', 'refuge', 'admin']
        && request.resource.data.publisherId == request.auth.uid
        && request.resource.data.status in ['brouillon', 'disponible']
        && request.resource.data.acceptedApplicationId == null;

      allow update: if signedIn() && (
        // L'annonceur : réservation uniquement depuis « disponible », adoption uniquement depuis « réservée ».
        (resource.data.publisherId == request.auth.uid
          && request.resource.data.publisherId == resource.data.publisherId
          && (request.resource.data.status != 'reservee' || resource.data.status in ['disponible', 'reservee'])
          && (request.resource.data.status != 'adoptee' || resource.data.status in ['reservee', 'adoptee']))
        // Le candidat accepté qui retire sa candidature libère l'animal.
        || (resource.data.status == 'reservee'
          && resource.data.acceptedApplicationId == listingId + '_' + request.auth.uid
          && changed().hasOnly(['status', 'acceptedApplicationId', 'updatedAt'])
          && request.resource.data.status == 'disponible'
          && request.resource.data.acceptedApplicationId == null)
      );

      // Une annonce n'est jamais supprimée : elle est archivée.
      allow delete: if false;

      match /photos/{photoId} {
        allow read: if true;
        allow write: if signedIn()
          && getAfter(/databases/$(database)/documents/adoptions/$(listingId)).data.publisherId == request.auth.uid;
      }
    }

    // Candidatures : id = {listingId}_{applicantId}, donc une seule par personne et par annonce.
    match /adoptionApplications/{applicationId} {
      // `resource == null` : permet de vérifier qu'on n'a pas déjà candidaté.
      allow get: if signedIn() && (resource == null
        || resource.data.applicantId == request.auth.uid
        || resource.data.publisherId == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.applicantId == request.auth.uid || resource.data.publisherId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.applicantId == request.auth.uid
        && applicationId == request.resource.data.listingId + '_' + request.auth.uid
        && request.resource.data.status == 'envoyee'
        && listingDoc(request.resource.data.listingId).data.status in ['disponible', 'reservee']
        && listingDoc(request.resource.data.listingId).data.publisherId == request.resource.data.publisherId
        && request.resource.data.publisherId != request.auth.uid;

      allow update: if signedIn() && (
        (resource.data.publisherId == request.auth.uid
          && changed().hasOnly(['status', 'refusalReason', 'updatedAt'])
          && request.resource.data.status in ['en_etude', 'acceptee', 'refusee', 'adoptee'])
        || (resource.data.applicantId == request.auth.uid
          && changed().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'retiree'
          && resource.data.status in ['envoyee', 'en_etude', 'acceptee'])
      );

      allow delete: if false;
    }

    // Happy Tails : publiées par l'adoptant de l'annonce, aimées par les membres connectés.
    match /happyTails/{tailId} {
      allow read: if true;

      allow create: if signedIn()
        && tailId == request.resource.data.listingId
        && request.resource.data.authorId == request.auth.uid
        && listingDoc(tailId).data.adopterId == request.auth.uid
        && request.resource.data.likeCount == 0;

      allow update: if signedIn() && (
        (resource.data.authorId == request.auth.uid
          && !changed().hasAny(['authorId', 'listingId', 'likeCount', 'createdAt']))
        // Un « j'aime » : +1 si le like est créé dans le même lot, -1 s'il est supprimé.
        || (changed().hasOnly(['likeCount'])
          && ((request.resource.data.likeCount == resource.data.likeCount + 1
              && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/likedHappyTails/$(tailId))
              && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/likedHappyTails/$(tailId)))
            || (request.resource.data.likeCount == resource.data.likeCount - 1
              && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/likedHappyTails/$(tailId))
              && exists(/databases/$(database)/documents/users/$(request.auth.uid)/likedHappyTails/$(tailId)))))
      );

      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // Signalements (annonces d'adoption, Happy Tails) : lus par l'administrateur uniquement.
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if signedIn() && userRole() == 'admin';
    }

    // Tout le reste reste fermé tant que les autres modules n'ont pas ajouté leurs règles.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
